<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Use only nuget.org, whatever feeds the machine has configured, so every clone restores the same way. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
